# Add these values in Netlify: Site configuration > Environment variables.
# Never commit real credentials.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_CAMPAIGNS_LIST_KEY=

# Optional. Leave the defaults for a United States (.com) Zoho account.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_CAMPAIGNS_API_URL=https://campaigns.zoho.com

# Optional for Zoho Campaigns accounts using Topics.
ZOHO_CAMPAIGNS_TOPIC_ID=

# Legacy seller authentication and optional preserved Terminal test setup.
EVENT_REGISTER_ENV=test
EVENT_REGISTER_ACCESS_CODE=
# Generate a random value at least 32 characters long. Do not put it in the phone app.
EVENT_REGISTER_SESSION_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TERMINAL_LOCATION_ID=
# Sales-tax rate in basis points. Example: 820 = 8.20%. Use 0 only when appropriate.
EVENT_TAX_RATE_BPS=
TRAIL_JOURNAL_REVIEW_TOKEN=

# Direct checkout. Leave disabled until test setup is complete.
COMMERCE_ENABLED=false
COMMERCE_MODE=test
COMMERCE_LIVE_APPROVED=false
COMMERCE_SITE_URL=https://nomadicpaws.co
# Generate a random value of at least 32 characters; server only.
COMMERCE_STATUS_SECRET=
# Signing secret for the NEW /api/commerce/webhook endpoint.
COMMERCE_STRIPE_WEBHOOK_SECRET=
# Confirmed shipping policy.
COMMERCE_SHIPPING_CENTS=500
COMMERCE_SHIPPING_COUNTRIES=US
# Choose stripe (usage-priced automatic tax) or manual (approved fixed jurisdiction only).
COMMERCE_WEB_TAX_MODE=
COMMERCE_WEB_TAX_RATE_BPS=
COMMERCE_CASH_APP_PAY=false
# Monthly shipping codes. UTC timestamps must be explicit; no automatic emails are sent.
COMMERCE_SHIPPING_PERKS=[]
