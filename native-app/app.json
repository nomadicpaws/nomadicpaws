{
  "expo": {
    "name": "Nomadic Paws",
    "owner": "nomadic-paws",
    "slug": "cheeto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fdfaf5"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "co.nomadicpaws.admin",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Nomadic Paws uses Bluetooth to connect to the Stripe card reader.",
        "NSLocationWhenInUseUsageDescription": "Location access is required by Stripe to accept in-person payments.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-secure-store",
      ["expo-local-authentication", { "faceIDPermission": "Use Face ID or your iPhone passcode to unlock the private Nomadic Paws workspace." }]
    ],
    "android": {
      "package": "co.nomadicpaws.admin"
    },
    "extra": {
      "apiUrl": "https://nomadicpaws.co",
      "eas": {
        "projectId": "9aba061e-f3f3-498e-b4fc-27f561dcedeb"
      }
    }
  }
}
