{
  "expo": {
    "name": "Nomadic Paws",
    "owner": "nomadic-paws",
    "slug": "cheeto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9aba061e-f3f3-498e-b4fc-27f561dcedeb",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fdfaf5"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "co.nomadicpaws.admin",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose Cheeto photos and adventure images to add to your private Nomadic Paws Media Library."
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID or your iPhone passcode to unlock the private Nomadic Paws workspace."
        }
      ],
      "expo-sharing"
      ,
      [
        "expo-media-library",
        {
          "photosPermission": "Choose and organize Cheeto photos and videos for the private Nomadic Paws studio.",
          "savePhotosPermission": "Save finished Nomadic Paws images and videos so they can be shared on Instagram, TikTok, or YouTube."
        }
      ],
      "./plugins/with-local-notifications-only"
    ],
    "android": {
      "package": "co.nomadicpaws.admin"
    },
    "extra": {
      "apiUrl": "https://nomadicpaws.co",
      "eas": {
        "projectId": "9aba061e-f3f3-498e-b4fc-27f561dcedeb"
      }
    }
  }
}
