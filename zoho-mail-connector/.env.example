# Public URL of this separate Netlify site, without a trailing slash.
CONNECTOR_BASE_URL=

# Generate two different long random values. Never reuse website secrets.
CONNECTOR_AUTH_SECRET=
CONNECTOR_ACCESS_CODE=

# Zoho Mail US data center.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_MAIL_API_URL=https://mail.zoho.com/api

# Add these privately in the connector's Netlify site only.
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_CLIENT_SECRET=
ZOHO_MAIL_REFRESH_TOKEN=
ZOHO_MAIL_ACCOUNT_ID=
ZOHO_MAIL_FROM_ADDRESS=

